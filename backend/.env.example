# =============================================================================
# Plantilla de variables de entorno. Copia este archivo como .env y ajusta.
# NUNCA subas el .env al repositorio.
# =============================================================================

# ==== Servidor ====
PORT=4000

# ==== Base de datos MySQL ====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chocoberry
# true si la base de datos está en la nube y exige conexión SSL
DB_SSL=false

# ==== Autenticación (JWT) ====
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d

# ==== CORS ====
# Único origen permitido para consumir la API (el frontend en React)
FRONTEND_URL=http://localhost:5173
