# Plantilla de variables de entorno.

# ==== Servidor ====
NODE_ENV=development
PORT=4000

# ==== Base de datos MySQL ====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chocoberry
# true si la base de datos está en la nube y exige conexión SSL
DB_SSL=false
# Opcional: certificado CA del proveedor en formato PEM (puede usar \n).
DB_SSL_CA=

# ==== Autenticación (JWT) ====
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d

# ==== CORS ====
# Único origen permitido para consumir la API (el frontend en React)
FRONTEND_URL=http://localhost:5173

# ==== Correo (Brevo) ====
# smtp = Nodemailer (desarrollo local); brevo-api = API HTTP (Render).
MAIL_PROVIDER=smtp
# Solo para MAIL_PROVIDER=brevo-api.
BREVO_API_KEY=
# Solo para MAIL_PROVIDER=smtp.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=tu_usuario_smtp
MAIL_PASS=tu_clave_smtp
# Remitente verificado en Brevo. Acepta "Nombre <correo@dominio.com>".
MAIL_FROM="ChocoBerry <correo@tudominio.com>"

# === Cloudinary
# Obligatorias salvo en pruebas (NODE_ENV=test usa un doble en memoria).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Vigencia en segundos de las URLs firmadas de comprobantes y evidencias.
CLOUDINARY_SIGNED_URL_TTL=3600
